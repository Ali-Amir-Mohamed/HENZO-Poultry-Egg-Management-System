// Mise en ligne de HENZO sur Cloudflare (Workers, fichiers statiques).
// Cloudflare construit l'appli (npm run build) puis publie le dossier dist.
// Toutes les pages de l'appli renvoient index.html (application d'une seule page).
// worker/index.js passe avant les fichiers : redirige http vers https et ajoute les en-têtes de sécurité.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "henzo",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
