// Mise en ligne de HENZO sur Cloudflare (Workers, fichiers statiques).
// Cloudflare construit l'appli (npm run build) puis publie le dossier dist.
// Toutes les pages de l'appli renvoient index.html (application d'une seule page).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "henzo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
