# Copier en .env.local (en local) et définir les mêmes variables dans Cloudflare Pages
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Notifications sur téléphone : clé PUBLIQUE seulement (la clé privée va dans Supabase > Edge Functions > Secrets)
VITE_VAPID_PUBLIC_KEY=
